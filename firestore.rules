rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eine anonyme Stimme pro Browser und Spiel: Dokument-ID = <spiel>_<uid>
    match /votes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['game', 'uid', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.game is string
        && request.resource.data.game.size() < 30
        && id == request.resource.data.game + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
